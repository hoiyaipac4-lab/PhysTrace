* text=auto
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
# Preserve the anonymous payload bytes and line endings.
simulation/** -text
# Heavy scene/model/texture/evidence objects use Git LFS, including ASCII meshes/USD.
*.usd filter=lfs diff=lfs merge=lfs -text
